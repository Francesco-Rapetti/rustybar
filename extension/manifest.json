{
  "manifest_version": 3,
  "name": "RustyBar",
  "version": "1.4",
  "description": "Google Meet's mic, camera, raised hand and Leave in RustyBar, the bar of this Mac.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["scripting"],
  "host_permissions": ["https://meet.google.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://meet.google.com/*"], "js": ["meet.js"], "run_at": "document_idle" }
  ]
}
