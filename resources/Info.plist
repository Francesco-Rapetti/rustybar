<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- scripts/bundle.sh fills in @VERSION@. LSUIElement: no icon in the Dock, no menu bar of its own.
     The usage descriptions are what macOS shows when it asks a permission, once, for RustyBar -->
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>RustyBar</string>
  <key>CFBundleDisplayName</key>
  <string>RustyBar</string>
  <key>CFBundleIdentifier</key>
  <string>io.github.francesco-rapetti.rustybar</string>
  <key>CFBundleExecutable</key>
  <string>rustybar</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@VERSION@</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>LSMinimumSystemVersion</key>
  <string>13.0</string>
  <key>LSUIElement</key>
  <true/>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSAppleEventsUsageDescription</key>
  <string>RustyBar runs the commands of the Apple menu (restart, shut down, log out) and opens days in Calendar.</string>
  <key>NSCalendarsFullAccessUsageDescription</key>
  <string>RustyBar shows today's events in the bar.</string>
  <key>NSCalendarsUsageDescription</key>
  <string>RustyBar shows today's events in the bar.</string>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>macOS shows the names of the Wi-Fi networks only to apps with this permission.</string>
  <key>NSLocationUsageDescription</key>
  <string>macOS shows the names of the Wi-Fi networks only to apps with this permission.</string>
  <key>NSLocalNetworkUsageDescription</key>
  <string>RustyBar connects to your Home Assistant server.</string>
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>RustyBar connects and disconnects your Bluetooth audio devices.</string>
</dict>
</plist>
